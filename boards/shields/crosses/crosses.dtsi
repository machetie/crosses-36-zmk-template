#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>

#include "thirty_six_layout.dtsi"

&gggw_crosses_36_layout {
  transform = <&thirty_six_transform>;
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels
              = <NRF_PSEL(SPIM_SCK, 0, 17)>
              , <NRF_PSEL(SPIM_MOSI, 0, 6)>
              , <NRF_PSEL(SPIM_MISO, 0, 6)>
              ;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels
              = <NRF_PSEL(SPIM_SCK, 0, 17)>
              , <NRF_PSEL(SPIM_MOSI, 0, 6)>
              , <NRF_PSEL(SPIM_MISO, 0, 6)>
              ;
            low-power-enable;
        };
    };
};

&spi1 {
  status = "okay";
  compatible = "nordic,nrf-spim";
  pinctrl-0 = <&spi1_default>;
  pinctrl-1 = <&spi1_sleep>;
  pinctrl-names = "default", "sleep";
};

/ {

  chosen {
    zmk,kscan = &kscan0;
    zmk,physical-layout = &gggw_crosses_36_layout;
  };

  thirty_six_transform: keymap_transform2 {
    compatible = "zmk,matrix-transform";
    columns = <12>;
    rows = <5>;
    map = <
      RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)           RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
      RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)           RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
      RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)           RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
                      RC(4,3) RC(4,4) RC(4,5)           RC(4,6) RC(4,7) RC(4,8)
    >;
  };

  kscan0: kscan0 {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "col2row";
    wakeup-source;

    row-gpios
      = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
      ;
  };

};
