#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include "../crosses/thirty_six_layout.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &gggw_crosses_36_layout;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    // Auto-mouse layer processor (upstream Temporary Layer Input Processor)
    /omit-if-no-ref/ aml: aml {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <250>;
        excluded-positions = <3 11 12 13 23>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        // Left half trackball (reg 0)
        trackball_peripheral_split: trackball_peripheral_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };

        // Right half trackball (reg 1)
        trackball_right_split: trackball_right_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
        };
    };

    // Listener for left half trackball
    trackball_left_listener: trackball_left_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball_peripheral_split>;
        input-processors = <&aml 3 3000>;
    };

    // Listener for right half trackball
    trackball_right_listener: trackball_right_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball_right_split>;
        input-processors = <&aml 3 3000>;
    };

    thirty_six_transform: keymap_transform_dongle {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
                    RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8)
        >;
    };
};

&gggw_crosses_36_layout {
    transform = <&thirty_six_transform>;
};
